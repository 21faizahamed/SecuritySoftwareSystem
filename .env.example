# Security Certificate & Compliance Inspection System - Environment Configuration Template

# Database (MySQL via XAMPP) - Phase 2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=security_certificate_system
DB_USER=root
DB_PASSWORD=

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Authentication (Phase 5)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Bootstrap Account (Seeded on first run)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@securitysystem.local
INITIAL_ADMIN_PASSWORD=Admin@123456

